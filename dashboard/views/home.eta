<%~ includeFile("partials/header.eta", { user: user }) %>
<%~ includeFile("partials/message.eta") %>

<main class="omega-shell py-4 py-md-5">
  <section class="omega-hero">
    <span class="omega-eyebrow"><i class="fas fa-bolt"></i> GoatBot Control Center</span>
    <h1>Make your community<br>smarter with GoatBot.</h1>
    <p>Manage your groups, automate moderation, welcome new members and build a better chat experience — all from one simple dashboard.</p>
    <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
      <% if (global.botID) { %>
        <span class="omega-status"><span class="omega-status-dot"></span> Bot is online</span>
        <button class="omega-btn-light" id="addme"><i class="fas fa-plus-circle"></i> Add GoatBot to your group</button>
      <% } else { %>
        <span class="omega-status"><span class="omega-status-dot" style="background:#ffbd6b;box-shadow:0 0 0 5px rgba(255,189,107,.16)"></span> Bot is currently offline</span>
      <% } %>
      <a class="text-white fw-bold text-decoration-none" href="/dashboard"><i class="fas fa-arrow-right me-2"></i>Open dashboard</a>
    </div>
  </section>

  <section class="omega-stats" aria-label="Bot statistics">
    <article class="omega-stat">
      <span class="omega-stat-icon"><i class="fas fa-comments"></i></span>
      <div><strong><%= global.db.allThreadData.length %></strong><span>Groups connected</span></div>
    </article>
    <article class="omega-stat">
      <span class="omega-stat-icon"><i class="fas fa-users"></i></span>
      <div><strong><%= global.db.allUserData.length %></strong><span>Users in the community</span></div>
    </article>
    <article class="omega-stat">
      <span class="omega-stat-icon"><i class="fas fa-shield-alt"></i></span>
      <div><strong>24/7</strong><span>Automation ready</span></div>
    </article>
  </section>

  <section>
    <div class="omega-page-head">
      <div><h2 class="omega-section-heading">Everything you need to manage your groups</h2><p class="omega-muted mb-0">Powerful tools, wrapped in a clean and simple experience.</p></div>
    </div>
    <div class="omega-feature-grid">
      <article class="omega-card"><div class="omega-card-icon"><i class="fas fa-shield-alt"></i></div><h3>Smart moderation</h3><p>Keep conversations healthy with moderation tools and group controls.</p></article>
      <article class="omega-card"><div class="omega-card-icon"><i class="fas fa-hand-sparkles"></i></div><h3>Welcome experiences</h3><p>Greet new members and share important group rules or announcements.</p></article>
      <article class="omega-card"><div class="omega-card-icon"><i class="fas fa-terminal"></i></div><h3>Custom commands</h3><p>Create custom commands and tailor the bot to your community.</p></article>
      <article class="omega-card"><div class="omega-card-icon"><i class="fas fa-trophy"></i></div><h3>Levels and activity</h3><p>Recognize active members with levels and experience points.</p></article>
    </div>
  </section>
</main>

<script>
  (function() {
    const btn = $('#addme');
    if (btn.length > 0) {
      btn.on("click", () => {
        window.open("https://www.facebook.com/" + "<%= global.botID %>", "_blank", "noopener");
      });
    }
  })();
</script>
<%~ includeFile('partials/footer.eta') %>
