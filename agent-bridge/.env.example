# Optional bridge settings. The bridge is isolated and disabled by default.
AGENT_BRIDGE_ENABLED=false
# Worker polling requires a separate explicit opt-in after backend deployment and approval tests.
AGENT_WORKER_ENABLED=false
AGENT_BACKEND_URL=
AGENT_BRIDGE_SECRET=
AGENT_WORKSPACE_ROOT=
# Comma-separated Facebook sender IDs permitted to submit requests.
AGENT_ALLOWED_SENDER_IDS=
